{
  "permissions": {
    "allow": [
      "Bash(./gradlew *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Bash(git push*)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/keystore.properties)"
    ]
  }
}
